# local environment variables - never commit
ArthOMix/.Renviron
ArthOMix/.env

# OS / editor
.DS_Store
*~
.Rproj.user/
.Rhistory
.RData
renv/library/
renv/staging/

# ArthOMix/data/: regenerable runtime caches and reserved-but-unused folders
# - never bundled datasets, which are meant to be committed (large .rds/.RData
# files route through git-lfs per .gitattributes above).
ArthOMix/data/.cache/
ArthOMix/data/uploads/*
!ArthOMix/data/uploads/.gitkeep

# ArthOMix/results/: regenerable publication figures/tables produced by
# re-running an analysis stage - only the folder skeleton is tracked.
ArthOMix/results/**/*
!ArthOMix/results/**/
!ArthOMix/results/**/.gitkeep

# ArthOMix/reproduce/: reproducibility-verification scripts (tracked) and
# their outputs (not tracked - regenerable by re-running the script, and the
# raw/ subdirs hold downloaded source data, some hundreds of MB).
ArthOMix/reproduce/**/output/
ArthOMix/reproduce/**/raw/
