# ArthOMix base image: R 4.4.2 + system libs + every R/Bioconductor package + mofapy2.
# Built once on GitHub Actions (amd64, no 30-minute limit) and pulled by the Space image
# (Dockerfile.space), because the Hugging Face builder times out on the ~450-package
# renv restore. Rebuild only when renv.lock changes.
FROM rocker/r-ver:4.4.2

LABEL org.opencontainers.image.source="https://github.com/shweta-rai11/ArthOMix-app"
LABEL org.opencontainers.image.description="ArthOMix Explorer base image (R packages only, no app code or data)"

## cmake (nloptr), libuv1-dev (fs), libicu-dev (stringi) and make were missing in the
## first run; the rest was checked against Posit Package Manager's sysreqs for Ubuntu 24.04.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    cmake \
    make \
    libuv1-dev \
    libicu-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    pandoc \
    libfontconfig1-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff-dev \
    libjpeg-dev \
    libcairo2-dev \
    libxt-dev \
    libblas-dev \
    liblapack-dev \
    gfortran \
    zlib1g-dev \
    libmagick++-dev \
    libglpk-dev \
    libglu1-mesa-dev \
    libgl1-mesa-dev \
    freeglut3-dev \
    libhdf5-dev \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

## MOFA2 runs its factor model through the Python package mofapy2 (the app calls
## MOFA2::run_mofa(use_basilisk = FALSE) and resolves the interpreter from
## RETICULATE_PYTHON).
RUN pip3 install --no-cache-dir --break-system-packages "mofapy2==0.7.5" || pip3 install --no-cache-dir "mofapy2==0.7.5"
ENV RETICULATE_PYTHON=/usr/bin/python3

## Packages go into the system site-library (readable by any runtime UID).
## Disable the renv cache: it would symlink into /root/.cache, which an
## unprivileged runtime user cannot read.
## renv gives each package install 300 s by default; missMethyl needs longer. The
## project's .Rprofile raises it to 9000 s, but that file is not in this build context.
ENV RENV_CONFIG_CACHE_ENABLED=FALSE
ENV RENV_CONFIG_INSTALL_TIMEOUT=9000
WORKDIR /build
RUN R -e "install.packages('renv', repos = 'https://cloud.r-project.org')"
COPY renv.lock renv.lock

## Step 1 (about an hour): everything except four packages that failed in the first
## runs. Kept as its own layer so a problem in steps 2-3 does not redo this work.
RUN R -e "options(renv.install.timeout = 9000L); renv::restore(lockfile = 'renv.lock', library = .Library.site[1], prompt = FALSE, exclude = c('MCPcounter', 'missMethyl', 'DMRcate', 'ChAMP'))"

## Step 2: missMethyl (slow install; needed by DMRcate and ChAMP), then those two.
RUN R -e "options(renv.install.timeout = 9000L); renv::restore(lockfile = 'renv.lock', library = .Library.site[1], prompt = FALSE, packages = c('missMethyl', 'DMRcate', 'ChAMP'))"

## Step 3: MCPcounter is a GitHub package in a repo subfolder; inside the full restore
## graph renv failed with "target file ... already exists", so install it on its own,
## falling back to an explicit pinned install of the same commit as renv.lock.
RUN R -e "options(renv.install.timeout = 9000L); ok <- tryCatch({renv::restore(lockfile = 'renv.lock', library = .Library.site[1], prompt = FALSE, packages = 'MCPcounter'); TRUE}, error = function(e) {message('restore failed: ', conditionMessage(e)); FALSE}); if (!ok || !('MCPcounter' %in% rownames(installed.packages()))) renv::install('ebecht/MCPcounter/Source@b6eac73e91c246fcff0bb1a5c68a816cd588fc48', library = .Library.site[1], prompt = FALSE)"

## Fail the build early, with a readable message, if a core package is missing.
RUN R -e "need <- c('shiny','mixOmics','WGCNA','MOFA2','SNFtool','limma','minfi','missMethyl','DMRcate','ChAMP','MCPcounter'); miss <- setdiff(need, rownames(installed.packages())); if (length(miss)) stop('missing packages: ', paste(miss, collapse=', '))"
