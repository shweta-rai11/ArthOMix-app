# Copy this file to .Renviron (same directory) and fill in your Supabase
# project's own values - see Project Settings -> API in the Supabase
# dashboard. Use the anon/public key only; never the service_role key.
# .Renviron itself is git-ignored and must never be committed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
