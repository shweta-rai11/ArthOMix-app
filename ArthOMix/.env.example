# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored - never commit real keys.

# Powers ArthoChat. Get one at https://console.anthropic.com/settings/keys
# Set a spend limit on the workspace before going live: console.anthropic.com -> Settings -> Limits
ANTHROPIC_API_KEY=

# Port the container listens on internally. Leave as-is unless you know why you're changing it.
PORT=3838
